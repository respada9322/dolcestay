# Resend — contact form emails (server-only; never use NEXT_PUBLIC_ for these)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=DolceStay <noreply@seudominio.com>
RESEND_TO_EMAIL=geral@dolcestay.com

# Google Maps — interactive partners map (/parcerias)
# Next.js: only NEXT_PUBLIC_* variables are exposed to the browser.
# In Google Cloud Console, restrict the key to HTTP referrers such as:
#   http://localhost:3000/*  http://localhost:3001/*  https://your-domain.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Reviews — CTA below testimonials
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Google Analytics 4 — loaded only after explicit cookie consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
